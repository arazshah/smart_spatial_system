# Copy to .env and fill in. Never commit .env.

# Needed only for the LLM-planned arm (pipeline 2) and any notebook that
# calls smart_spatial_system's LLMQuerySpecGenerator or its LLM-backed
# s3geo.query() path. Everything else in this repository (data prep, the
# rule-based arm, the comparison metric, plotting) needs none of this.
#
# smart_spatial_system's OpenAICompatibleLLMClient checks these in this
# exact order and uses the first one set - fill in whichever matches your
# provider, no need to set all three. (Order carried over from
# smart-spatial-vienna-accessibility, where it was confirmed against
# orchestrator/planning/llm_spec_generator.py on 2026-09-12. RE-CONFIRM
# against 0.3.0's source the first time this repo actually runs the LLM
# arm - it is a pin bump away from the version that was verified.)
LLM_API_KEY=
AVALAI_API_KEY=
OPENAI_API_KEY=

# Only needed for AvalAI or another OpenAI-compatible endpoint that isn't
# api.openai.com. NOTE: the variable name is LLM_BASE_URL, not
# OPENAI_BASE_URL.
LLM_BASE_URL=https://api.avalai.ir/v1

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
