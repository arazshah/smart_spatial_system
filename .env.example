# Copy to .env and fill in. Never commit .env.

# LLM (any OpenAI-compatible API; the project was developed against AvalAI)
LLM_PROVIDER=avalai
OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_API_KEY=
LLM_FAST_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=chatgpt4o
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_PLANNING_ENABLED=true

# PostGIS password used by config/plugins/postgis_connector.yaml (password_env)
POSTGIS_PASSWORD=

# Optional
# SMART_SPATIAL_RUNTIME_DIR=var          # where outputs/, uploads/, projects/ are written
# GEOCHAT_PLUGIN_CONFIG_DIR=config/plugins

# Set to require every API request (except "/" and "/health") to send this
# value back as the X-API-Key header. Leave unset for local development or
# a single trusted network; set it before exposing the API beyond that.
# SMART_SPATIAL_API_KEY=
