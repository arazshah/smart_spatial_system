
# Smart Spatial System runtime/generated state
/var/
/outputs/
/output/
/uploads/
/projects/
/cache/
/artifacts/reports/
/examples/urmia_real_estate/output/
/examples/urmia_real_estate/osm_download/
/examples/istanbul_health_access/data/raw/*
!/examples/istanbul_health_access/data/raw/.gitkeep
/examples/istanbul_health_access/results/archive/
/examples/istanbul_health_access/var/
.ipynb_checkpoints/

# Local backup/temp files
*.bak
*.bak.*
*.before-*.bak
*.old
*backup*

# Frontend generated/vendor files
/frontend/node_modules/
/frontend/dist/
__pycache__/
*.py[cod]
.pytest_cache/

# Local secrets (use .env.example / frontend/.env.example as templates)
.env
.env.*
!.env.example

# Plugin config backups written by the settings API
/config/plugins/.backups/

# Local datasets (see data/README.md)
/data/*
!/data/README.md

# Generated artifacts and tool caches
/artifacts/
.ruff_cache/
.venv/
venv/

# Python packaging build artifacts (REFACTOR_PLAN Phase 8 -
# docs/PHASE8_BACKEND_PACKAGING_CLI_PLAN.md; pyproject.toml makes this repo
# a real setuptools build target, so `pip wheel .` / `pip install -e .`
# leave these behind)
/build/
*.egg-info/


# Local secret files (keep the folder, never the contents)
/secrets/*
!/secrets/.gitkeep
